# AFTERMATH LIVE Backend Configuration
# Copy this file to .env and fill in your values. Never commit .env.

# Optional: Gemini API key for structured function-calling extraction.
# Leave blank to run in offline/local fallback mode.
GEMINI_API_KEY=

# Gemini model to use when GEMINI_API_KEY is configured
GEMINI_MODEL=gemini-2.5-flash

# Request timeout (seconds) for Gemini API calls before falling back to offline
GEMINI_TIMEOUT_SECONDS=8.0

# Confidence threshold below which promises are flagged as low-confidence (calibrated on labelled_50.json)
CONFIDENCE_THRESHOLD=0.55

# Server settings
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
